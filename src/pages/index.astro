// --- [設定エリア] 計算はここですべて終わらせます ---
const pageTitle = "CRAFT | 研ぎ澄まされた清掃";

const navItems = [
  { name: "TOP", href: "#top" },
  { name: "CONCEPT", href: "#concept" },
  { name: "CRAFT", href: "#craft" },
  { name: "PRICE", href: "#price" },
];

// 表示したい平米数のリスト
const targetSizes = [75, 80, 90, 100, 120, 150];

// 料金計算関数
const calculatePrice = (m2) => {
  let price = 9500;
  if (m2 > 85 && m2 <= 100) {
    price = 9500 + Math.ceil((m2 - 85) / 5) * 500;
  } else if (m2 > 100) {
    price = 11000 + Math.ceil((m2 - 100) / 5) * 1000;
  }
  return price.toLocaleString();
};
