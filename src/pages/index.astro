<script is:inline>
  // DOMが完全に読み込まれてから実行
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('linen-modal');
    const openBtn = document.getElementById('open-linen-modal');
    const closeBtn = document.getElementById('close-linen-modal');

    // 要素が存在するかチェック
    if (openBtn && modal && closeBtn) {
      
      // 開くボタン
      openBtn.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation(); // 親のdetailsが開閉するのを防ぐ
        modal.classList.add('is-visible');
        document.body.style.overflow = 'hidden'; // 背面スクロール禁止
      };

      // 閉じるボタン
      closeBtn.onclick = () => {
        modal.classList.remove('is-visible');
        document.body.style.overflow = '';
      };

      // 背景クリックで閉じる
      window.onclick = (event) => {
        if (event.target === modal) {
          modal.classList.remove('is-visible');
          document.body.style.overflow = '';
        }
      };
    }
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // モーダル制御用の共通関数
    const setupModal = (modalId, openBtnId, closeBtnId) => {
      const modal = document.getElementById(modalId);
      const openBtn = document.getElementById(openBtnId);
      const closeBtn = document.getElementById(closeBtnId);

      if (openBtn && modal && closeBtn) {
        openBtn.onclick = (e) => {
          e.preventDefault();
          e.stopPropagation();
          modal.classList.add('is-visible');
          document.body.style.overflow = 'hidden';
        };

        closeBtn.onclick = () => {
          modal.classList.remove('is-visible');
          document.body.style.overflow = '';
        };

        // 背景クリックで閉じる処理をwindow全体に一度だけ設定（あるいは各モーダルに設定）
        modal.onclick = (event) => {
          if (event.target === modal) {
            modal.classList.remove('is-visible');
            document.body.style.overflow = '';
          }
        };
      }
    };

    // 2番目：リネン管理
    setupModal('linen-modal', 'open-linen-modal', 'close-linen-modal');
    
    // 3番目：運営代行
    setupModal('proxy-modal', 'open-proxy-modal', 'close-proxy-modal');
  });
</script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    
    // --- 共通の制御関数 ---
    const setupToggle = (triggerId, targetId, activeClass, isModal = false) => {
      const trigger = document.getElementById(triggerId);
      const target = document.getElementById(targetId);
      if (!trigger || !target) return;

      const open = () => {
        target.classList.add(activeClass);
        document.body.style.overflow = 'hidden'; // 背面のスクロールを止める
      };

      const close = () => {
        target.classList.remove(activeClass);
        document.body.style.overflow = ''; // スクロール再開
      };

      trigger.onclick = (e) => {
        e.preventDefault();
        e.stopPropagation();
        target.classList.contains(activeClass) ? close() : open();
      };

      // モーダルの場合、背景クリックで閉じる
      if (isModal) {
        target.onclick = (e) => {
          if (e.target === target) close();
        };
      }

      return { open, close };
    };

    // --- 1. スマホメニューの制御 ---
    const mobileMenu = setupToggle('menu-trigger', 'mobile-menu', 'is-open');
    
    // メニュー内のリンクをクリックしたら閉じる
    const menuLinks = document.querySelectorAll('.menu-link');
    menuLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (mobileMenu) mobileMenu.close();
      });
    });

    // メニューの「BACK（閉じる）」ボタン
    const menuCloseBtn = document.getElementById('menu-close');
    if (menuCloseBtn) {
      menuCloseBtn.onclick = () => mobileMenu.close();
    }

    // --- 2. リネン管理ポップアップ ---
    const linenModal = setupToggle('open-linen-modal', 'linen-modal', 'is-visible', true);
    const linenCloseBtn = document.getElementById('close-linen-modal');
    if (linenCloseBtn) {
      linenCloseBtn.onclick = () => {
        const modal = document.getElementById('linen-modal');
        modal.classList.remove('is-visible');
        document.body.style.overflow = '';
      };
    }

    // --- 3. 運営代行シミュレーションポップアップ ---
    const proxyModal = setupToggle('open-proxy-modal', 'proxy-modal', 'is-visible', true);
    const proxyCloseBtn = document.getElementById('close-proxy-modal');
    if (proxyCloseBtn) {
      proxyCloseBtn.onclick = () => {
        const modal = document.getElementById('proxy-modal');
        modal.classList.remove('is-visible');
        document.body.style.overflow = '';
      };
    }
  });
</script>
