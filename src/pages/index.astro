<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    
    const setupToggle = (triggerId, targetId, activeClass, isModal = false) => {
      const trigger = document.getElementById(triggerId);
      const target = document.getElementById(targetId);
      if (!trigger || !target) return;

      trigger.onclick = (e) => {
        // --- 修正ポイント ---
        e.preventDefault();
        e.stopPropagation(); // 他の要素（detailsなど）にクリックを伝えない
        
        if (target.classList.contains(activeClass)) {
          target.classList.remove(activeClass);
          document.body.style.overflow = '';
        } else {
          target.classList.add(activeClass);
          document.body.style.overflow = 'hidden';
        }
      };

      if (isModal) {
        target.onclick = (e) => {
          if (e.target === target) {
            target.classList.remove(activeClass);
            document.body.style.overflow = '';
          }
        };
      }
    };

    // FAQ内のボタン（詳細・計算例）が勝手にページ移動しないように保護
    const faqButtons = document.querySelectorAll('.detail-open-btn');
    faqButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault(); // URLに「#」が付くのを防ぐ
        e.stopPropagation(); // 親のアコーディオンが閉じたり開いたりするのを防ぐ
      });
    });

    // 既存の呼び出し
    setupToggle('menu-trigger', 'mobile-menu', 'is-open');
    setupToggle('open-linen-modal', 'linen-modal', 'is-visible', true);
    setupToggle('open-proxy-modal', 'proxy-modal', 'is-visible', true);
  });
</script>
