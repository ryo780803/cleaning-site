<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <style>
        :root {
            --bg-color: #0a0a0a;
            --accent-color: #d4af37;
            --text-color: #ffffff;
            --muted-color: #666666;
        }
        body {
            margin: 0; background: var(--bg-color); color: var(--text-color);
            font-family: 'Helvetica Neue', 'Hiragino Kaku Gothic ProN', sans-serif; 
            scroll-behavior: smooth; line-height: 1.6;
        }

        header {
            position: fixed; top: 0; width: 100%; height: 70px;
            display: flex; justify-content: space-between; align-items: center;
            padding: 0 5%; box-sizing: border-box; z-index: 1000;
            background: rgba(10, 10, 10, 0.9); backdrop-filter: blur(15px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }
        .nav-desktop { display: flex; gap: 30px; }
        .nav-desktop a { color: white; text-decoration: none; font-size: 0.7rem; letter-spacing: 0.15em; opacity: 0.6; transition: 0.3s; }
        .nav-desktop a:hover { opacity: 1; color: var(--accent-color); }

        section { width: 100%; padding: 120px 10%; box-sizing: border-box; }
        .label { color: var(--accent-color); font-size: 0.7rem; letter-spacing: 0.4em; display: block; margin-bottom: 1.5rem; }
        h2 { font-size: clamp(1.8rem, 5vw, 2.5rem); font-weight: 200; margin-bottom: 2rem; letter-spacing: 0.05em; }

        .hero {
            height: 90vh; display: flex; flex-direction: column; justify-content: center;
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)), url('https://images.unsplash.com/photo-1584622650111-993a426fbf0a?auto=format&fit=crop&q=80');
            background-size: cover; background-position: center;
        }
        .hero h1 { font-size: clamp(2.5rem, 8vw, 6rem); line-height: 1; margin: 0; font-weight: 200; }

        .craft-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 60px 40px; margin-top: 60px; }
        .craft-item { border-top: 1px solid #222; padding-top: 30px; }
        .craft-num { font-size: 0.7rem; color: var(--accent-color); margin-bottom: 15px; display: block; }
        .craft-title { font-size: 1.2rem; font-weight: 400; margin-bottom: 15px; }
        .craft-desc { font-size: 0.85rem; color: #888; line-height: 2; }

        /* 料金カードグリッド */
        .price-card-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            max-width: 1100px;
            margin: 40px auto 0;
        }

        .premium-card {
            background: #f8f9fa;
            border-radius: 12px;
            padding: 40px 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border: 1px solid #ddd;
            box-shadow: 0 6px 0px #ccc;
            position: relative;
            top: 0;
            transition: all 0.1s ease;
            cursor: pointer;
        }
        .premium-card:hover { top: 4px; box-shadow: 0 2px 0px #ccc; background: #fff; }
        .card-m2 { font-size: 1.1rem; color: #333; font-weight: bold; margin-bottom: 8px; }
        .card-price { font-size: 1.5rem; color: var(--accent-color); font-weight: 300; }
        .card-price span { font-size: 0.65rem; color: #999; margin-left: 4px; }

        @media (max-width: 1024px) { .price-card-grid { grid-template-columns: repeat(2, 1fr); } }
        @media (max-width: 768px) { section { padding: 80px 5%; } .nav-desktop { display: none; } }
        @media (max-width: 640px) { .price-card-grid { grid-template-columns: 1fr; } }
    </style>
</head>
